# upstream for uWSGI
upstream uwsgi_app {
    server unix:/tmp/uwsgi_app.sock;  # Done by Claude, requires review
}

# Docker's internal DNS — re-resolve upstream hostnames every 30s so nginx
# picks up new container IPs after a restart instead of caching stale ones.
# ipv6=off avoids binding issues when containers only listen on IPv4.
resolver 127.0.0.11 valid=30s ipv6=off;

# Redirect HTTP to HTTPS; allow Let's Encrypt renewal challenges
server {
    listen      80;
    server_name stllr.io www.stllr.io;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen      443 ssl;
    server_name stllr.io www.stllr.io;

    ssl_certificate     /etc/letsencrypt/live/stllr.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stllr.io/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Reject requests where ?next= is itself a URL containing another ?next=
    # (only happens with bots building infinite redirect chains)
    if ($arg_next ~* "next=") {
        return 400;
    }

    location / {
        include     /etc/nginx/uwsgi_params;
        uwsgi_pass  uwsgi_app;
    }

    location /ws/ {
        # Variable forces nginx to use the resolver on each request rather than
        # caching daphne's IP at startup — prevents stale DNS after container restarts.
        set $daphne_upstream http://daphne:9001;
        proxy_pass          $daphne_upstream;
        proxy_http_version  1.1;
        proxy_set_header    Upgrade $http_upgrade;
        proxy_set_header    Connection "upgrade";
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_redirect      off;
    }

    location /static/ {
        alias   /code/stllr/static/prod/;
    }

    location /media/ {
        alias   /code/stllr/media/prod/;
    }
}
